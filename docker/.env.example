# urbown – lokaler Docker-Stack. Nur Platzhalter, keine echten Werte.
# docker/.env erzeugen: sh docker/scripts/gen-local-env.sh (setzt alle Geheimwerte zufällig).

############ Geheimwerte (werden vom Skript gesetzt) ############
POSTGRES_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
ANON_KEY=__GENERATE__
SERVICE_ROLE_KEY=__GENERATE__
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=__GENERATE__
PG_META_CRYPTO_KEY=__GENERATE__
S3_PROTOCOL_ACCESS_KEY_ID=__GENERATE__
S3_PROTOCOL_ACCESS_KEY_SECRET=__GENERATE__

############ Host-Ports (versetzt zum Supabase-Standard, neben drivers.one lauffähig) ############
KONG_HTTP_PORT=8100
POSTGRES_HOST_PORT=5433
STUDIO_PORT=3101
MAILPIT_WEB_PORT=8125
MAILPIT_SMTP_PORT=1125
WEB_PROD_PORT=3102

############ Adressen ############
SUPABASE_PUBLIC_URL=http://localhost:8100
API_EXTERNAL_URL=http://localhost:8100/auth/v1
SITE_URL=http://app.localhost:3100
ADDITIONAL_REDIRECT_URLS=http://app.localhost:3100/**,http://localhost:3100/**

############ Auth ############
DISABLE_SIGNUP=true
JWT_EXPIRY=3600
SMTP_ADMIN_EMAIL=no-reply@urbown.local

############ Datenbank ############
POSTGRES_DB=postgres
PGRST_DB_SCHEMAS=public,storage,graphql_public

############ Studio ############
STUDIO_DEFAULT_ORGANIZATION=urbown
STUDIO_DEFAULT_PROJECT=urbown lokal

############ Functions ############
FUNCTIONS_VERIFY_JWT=false

############ Web-Container (Profil prod) ############
WEB_SITE_URL=http://localhost:3102
WEB_APP_URL=http://app.localhost:3102
WEB_DEMO_URL=https://demo.urbown.com
