# urbown web – Umgebungsvariablen (nur Platzhalter, keine Geheimnisse).
# Lokal ist keine eigene Datei nötig. Eigene Werte in web/.env.local (wird nicht eingecheckt).

# Adressen (UB03 2.1). Lokal: http://localhost:3100 / http://app.localhost:3100
NEXT_PUBLIC_SITE_URL=https://urbown.com
NEXT_PUBLIC_APP_URL=https://app.urbown.com
NEXT_PUBLIC_DEMO_URL=https://demo.urbown.com

# Suchmaschinen: nur auf der Live-Seite «true». Sonst noindex + robots.txt «Disallow: /».
SITE_INDEXABLE=false

# Interne Seite /_styleguide: lokal und auf Staging «true», live leer lassen.
ENABLE_STYLEGUIDE=true

# Mailversand: console | smtp | resend
#   lokal: smtp an Mailpit (docker compose), ohne Docker: console
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1125
RESEND_API_KEY=
MAIL_FROM=urbown <no-reply@urbown.com>
MAIL_TO_CONTACT=info@urbown.com

# Cloudflare Turnstile. Ohne Werte ausserhalb von production: öffentliche Testschlüssel.
# In production ohne Werte bricht der Start ab.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Nur lokal/CI: Testschlüssel auch mit «next start» (production) erlauben. Auf Servern nie setzen.
TURNSTILE_ALLOW_TEST_KEYS=false
